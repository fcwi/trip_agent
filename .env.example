# 要載入的檔案為 src/tripdata_<VITE_TRIP_ID>.jsx
VITE_TRIP_ID=2026_busan

# 部署在網域根目錄時填 /；GitHub Pages 子目錄範例為 /trip_agent/
VITE_BASE_PATH=/trip_agent/

# Open Graph 網址；正式部署時建議設定完整網址
VITE_PUBLIC_SITE_URL=https://example.com/trip_agent/

# 下列為既有服務設定。請保留自己 .env 裡的實際值，不要提交密鑰。
# 若尚未設定，功能會依各模組的容錯方式停用或要求輸入。
VITE_ENCODED_KEY=
VITE_ENCODED_MAPS_KEY=
VITE_ENCODED_MAPTILER_KEY=
VITE_ENCODED_GAS_URL=
VITE_ENCODED_GAS_TOKEN=
