# 舊版部署的旅程 ID，用於舊資料遷移與自訂 GAS Property 相容。
# 畫面行程改由網址 ?trip= 與 src/config/tripCatalog.js 的日期自動選擇。
VITE_TRIP_ID=2026_busan

# 部署在網域根目錄時填 /；GitHub Pages 子目錄範例為 /trip_agent/
VITE_BASE_PATH=/trip_agent/

# Open Graph 網址；正式部署時建議設定完整網址
VITE_PUBLIC_SITE_URL=https://example.com/trip_agent/

# 正式環境預設不輸出除錯日誌；僅在需要排查問題時暫時設為 true
VITE_ENABLE_DEBUG_LOGS=false

# API 密鑰改放後端 .env.server，參考 server/.env.example。

# 選用。僅套用於上述舊版部署行程；其他行程由 GAS 依實際 tripId 分隔。
VITE_GAS_TRIP_PROPERTY_KEY=
