{
  "name": "trip-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:verify": "node scripts/verify-build-output.mjs",
    "test:e2e": "playwright test",
    "test:production": "node tests/production/journal-runtime.mjs",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "test": "node tests/run-tests.js",
    "security:check": "node scripts/check-source-secrets.mjs",
    "security:audit": "npm audit --omit=dev",
    "check": "npm run lint && npm run security:check && npm test",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"*.{js,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"*.{js,json,html}\"",
    "preview": "vite preview",
    "server": "node --env-file=.env.server server/app.mjs",
    "test:server": "node --test tests/server.test.mjs",
    "start": "node server/production.mjs"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-style-spec": "26.5.1",
    "framer-motion": "^12.23.26",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.559.0",
    "maplibre-gl": "6.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-swipeable": "^7.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.17",
    "terser": "^5.46.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.2.0"
  },
  "overrides": {
    "brace-expansion@^1.1.7": "1.1.21",
    "postcss-selector-parser": "7.1.7"
  }
}
